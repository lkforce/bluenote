          "unknown_reason": null,
          "value": "{\"schema\":\"discogs-public-v1\",\"master_id\":188292,\"release_id\":2392804,\"master_url\":\"https://www.discogs.com/master/188292\",\"release_url\":\"https://www.discogs.com/release/2392804\",\"retrieved_at\":\"2026-11-13T19:43:49+00:00\",\"expires_at\":\"2026-11-14T01:43:49+00:00\",\"title\":\"At The Cafe Bohemia Volume 2\",\"artists\":[\"Art Blakey & The Jazz Messengers\"],\"genres\":[\"Jazz\"],\"styles\":[\"Hard Bop\"],\"year\":1956,\"release_year\":1956,\"release_country\":\"US\",\"tracklist\":[{\"position\":\"A1a\",\"title\":\"Introduction By Art Blakey\",\"duration\":\"\",\"type_\":\"track\"},{\"position\":\"A1b\",\"title\":\"Sportin' Crowd\",\"duration\":\"\",\"type_\":\"track\"},{\"position\":\"A2\",\"title\":\"Like Someone In Love\",\"duration\":\"\",\"type_\":\"track\"},{\"position\":\"A3\",\"title\":\"Yesterdays\",\"duration\":\"\",\"type_\":\"track\"},{\"position\":\"B1\",\"title\":\"Avila And Tequila\",\"duration\":\"\",\"type_\":\"track\"},{\"position\":\"B2\",\"title\":\"I Waited For You\",\"duration\":\"\",\"type_\":\"track\"}],\"tracklist_source\":\"MASTER\",\"credits\":[{\"name\":\"Doug Watkins\",\"instrument\":\"Bass\",\"tracks\":\"\",\"scope\":\"release_credit_not_all_tracks\",\"source_type\":\"RELEASE\"},{\"name\":\"Art Blakey\",\"instrument\":\"Drums\",\"tracks\":\"\",\"scope\":\"release_credit_not_all_tracks\",\"source_type\":\"RELEASE\"},{\"name\":\"Horace Silver\",\"instrument\":\"Piano\",\"tracks\":\"\",\"scope\":\"release_credit_not_all_tracks\",\"source_type\":\"RELEASE\"},{\"name\":\"Hank Mobley\",\"instrument\":\"Tenor Saxophone\",\"tracks\":\"\",\"scope\":\"release_credit_not_all_tracks\",\"source_type\":\"RELEASE\"},{\"name\":\"Kenny Dorham\",\"instrument\":\"Trumpet\",\"tracks\":\"\",\"scope\":\"release_credit_not_all_tracks\",\"source_type\":\"RELEASE\"}],\"credits_source\":\"RELEASE\",\"notes\":\"Recorded live on November 23, 1955.\\n\\n1st original mono issue has: \\n- deep grooved blue/white Blue Note Records labels with 767 Lexington Ave N.Y.C. addess \\n- flat edge vinyl with RVG etched and \\\"P\\\" (otherwise wrongly called \\\"ear\\\") for Plastylite etched in the trail off, both sides \\n- 767 Lexington Ave., New York 21 address on back cover \\n- blank spine on cover \\n- Framed cover.\",\"notes_source\":\"RELEASE\"}",
